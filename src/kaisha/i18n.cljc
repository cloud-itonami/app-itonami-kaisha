(defn t
  "文言を返す。キーがなければキー名をそのまま出す（欠けた訳を隠さない）。"
  ([lang k] (t lang k {}))
  ([lang k params]
   (let [s (or (get-in messages [lang k]) (str k))]
     (str/replace s #"\{([a-z-]+)\}"
                  (fn [[_ p]] (str (get params (keyword p) (str "{" p "}"))))))))

(defn missing-keys
  "片方の言語にしかないキー。"
  []
  (let [ja (set (keys (:ja messages))) en (set (keys (:en messages)))]
    {:ja-only (sort (remove en ja)) :en-only (sort (remove ja en))}))
